APP_NAME=PaperDesk
APP_VERSION=0.1.0
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENALEX_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_WARMUP_ON_START=true
SQLITE_PATH=./data/paperdesk.db
CHROMA_PATH=./data/chroma
MILVUS_URI=
MILVUS_LITE_PATH=./data/milvus/paperdesk_milvus.db
MILVUS_AUTO_START=true
MILVUS_START_TIMEOUT_SECONDS=90
MILVUS_RUNTIME_DIR=./runtime/milvus
MILVUS_CONTAINER_NAME=paperdesk-milvus
MILVUS_IMAGE=milvusdb/milvus:v2.6.14
WORKSPACE_DIR=./workspace
UPLOAD_DIR=./workspace/uploads
REPORT_DIR=./workspace/reports
VECTORSTORE_DIR=./workspace/vectorstore
OPENALEX_BASE_URL=https://api.openalex.org
ARXIV_BASE_URL=http://export.arxiv.org/api/query
CORS_ORIGINS=*
