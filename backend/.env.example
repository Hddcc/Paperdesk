APP_NAME=PaperDesk
APP_VERSION=0.1.0
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_CONTEXT_TOKENS=
RESPONSE_RESERVE_TOKENS=16000
COMPACT_WARN_RATIO=0.72
COMPACT_FORCE_RATIO=0.90
RECENT_TURNS_MIN=8
MAX_EVIDENCE_ITEMS=8
MAX_EVIDENCE_CHARS_PER_ITEM=420
OPENALEX_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_WARMUP_ON_START=true
# Optional: leave blank to reuse Hugging Face's default cache under the user profile.
# EMBEDDING_CACHE_DIR=
# Use a reachable Hugging Face-compatible endpoint if the default hub times out.
# EMBEDDING_HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_LOCAL_FILES_ONLY=false
SQLITE_PATH=./data/paperdesk.db
MILVUS_URI=
MILVUS_LITE_PATH=./data/milvus/paperdesk_milvus.db
MILVUS_AUTO_START=true
MILVUS_START_TIMEOUT_SECONDS=90
MILVUS_RUNTIME_DIR=./runtime/milvus
MILVUS_CONTAINER_NAME=paperdesk-milvus
MILVUS_IMAGE=milvusdb/milvus:v2.6.14
WORKSPACE_DIR=./workspace
UPLOAD_DIR=./workspace/uploads
REPORT_DIR=./workspace/reports
RUNTIME_CONTEXT_DIR=./runtime/context
OPENALEX_BASE_URL=https://api.openalex.org
ARXIV_BASE_URL=http://export.arxiv.org/api/query
CORS_ORIGINS=*
